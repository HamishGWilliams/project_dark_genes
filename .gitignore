*gff3*

# HMMER / annotation database files
*.h3f
*.h3i
*.h3m
*.h3p

# Common large results / scratch directories
scratch/
tmp/
work/
results/raw/
results/intermediate/
busco_downloads/
02_annotation/db/*

# Logs / temp files
*.log
*.tmp
*.temp
*.swp

# Local software, environments, package caches, and databases
conda_envs/
conda_pkgs/
software/
eggnog_data/
.eggnog_data/

# Large BLAST/DIAMOND outputs generated on HPC
02_annotation/blastp/*
02_annotation/diamond/*.tsv
!02_annotation/diamond/*.top_hits.tsv
!02_annotation/diamond/*filtered*.tsv

# InterProScan raw outputs, summaries, and temporary files
02_annotation/interproscan/raw/
02_annotation/interproscan/tmp/
02_annotation/interproscan/test_input/
02_annotation/interproscan/summary/*.tsv
02_annotation/interproscan/summary/*.gff3
02_annotation/interproscan/summary/*.xml
02_annotation/interproscan/summary/*.json
*.xml
*.json

# eggNOG and SignalP large outputs generated on HPC
02_annotation/eggnog/raw/
02_annotation/eggnog/tmp/
02_annotation/eggnog/summary/*.tsv
02_annotation/signalp/raw/
02_annotation/signalp/tmp/

# Very large binaries and compiled tool artefacts
**/bin/mmseqs
**/mmseqs
*.so
*.a
*.o
