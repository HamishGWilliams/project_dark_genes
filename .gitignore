# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

## Additional ignores for bioinformatic work
# FASTA / sequence files
*.fa
*.fasta
*.fna
*.ffn
*.faa
*.frn
*.fas
*.fsa

# FASTQ / read files
*.fastq
*.fq
*.fastq.gz
*.fq.gz

# Graph / assembly files
*.gfa

# Compressed / archive files
*.gz
*.bz2
*.xz
*.zip
*.7z
*.tar
*.tgz
*.tar.gz
*.tar.bz2
*.tar.xz

# Alignment / mapping files
*.sam
*.bam
*.cram
*.bai
*.crai

# BLAST / DIAMOND / sequence database files
*.db
*.dmnd
*.phr
*.pin
*.psq
*.pal
*.nhr
*.nin
*.nsq
*.ndb
*.nog
*.nsd
*.nsi
*.pot
*.ptf
*.pto
*gff3*

# HMMER / annotation database files
*.h3f
*.h3i
*.h3m
*.h3p

# Logs / SLURM / temp files
*.log
*.out
*.err
*.tmp
*.temp
*.swp
logs/outputs/
logs/errors/

# Common large results / scratch directories
scratch/
tmp/
work/
results/raw/
results/intermediate/
busco_downloads/

# Local software, environments, package caches, and databases
conda_envs/
conda_pkgs/
software/
eggnog_data/
.eggnog_data/
.mamba/
.conda/

# Reference databases and generated search databases
02_annotation/db/
02_annotation/reference_dbs/

# Large BLAST outputs generated on HPC
02_annotation/blastp/

# Large DIAMOND outputs generated on HPC
# Raw all-hit TSVs are usually too large for Git. Keep only curated/top-hit summaries if explicitly added.
02_annotation/diamond/*.tsv
!02_annotation/diamond/*.top_hits.tsv
!02_annotation/diamond/*.best_hit*.tsv
!02_annotation/diamond/*.filtered.top_hits.tsv

# InterProScan outputs generated on HPC
02_annotation/interproscan/raw/
02_annotation/interproscan/tmp/
02_annotation/interproscan/test_input/
02_annotation/interproscan/summary/*.tsv
02_annotation/interproscan/summary/*.gff3
02_annotation/interproscan/summary/*.xml
02_annotation/interproscan/summary/*.json
*.xml
*.json

# eggNOG outputs generated on HPC
02_annotation/eggnog/raw/
02_annotation/eggnog/tmp/
02_annotation/eggnog/test_input/
02_annotation/eggnog/summary/*.tsv
02_annotation/eggnog/summary/*.txt

# SignalP outputs generated on HPC
02_annotation/signalp/raw/
02_annotation/signalp/tmp/
02_annotation/signalp/test_input/

# Master annotation outputs generated on HPC
# Keep scripts and notes in Git; keep full/test output tables local unless deliberately added later.
02_annotation/master/**/*.tsv
02_annotation/master/**/*.txt
02_annotation/master/**/qc/

# Very large binaries and compiled tool artefacts
**/bin/mmseqs
**/mmseqs
*.so
*.a
*.o

# DIAMOND large full-output files
02_annotation/diamond/raw/
02_annotation/diamond/filtered/*.diamond.tsv

# Keep only compact filtered/top-hit summaries if deliberately added
!02_annotation/diamond/filtered/*.top_hits.tsv
!02_annotation/diamond/filtered/*.best_hit*.tsv

# DIAMOND full raw/filtered outputs generated on HPC
02_annotation/diamond/raw/
02_annotation/diamond/filtered/*.diamond.tsv

# genome_loopkup tables
06_genome_lookup/*.tsv

# BUSCO duplication context files
07_duplication_context/*.tsv
